+
+    size_t start = 0;
+    while (start < str.size()) {
+        size_t end = str.find(',', start);
+        if (end == std::string::npos) {
+            end = str.size();
+        }
+
+        if (end > start) {
+            auto token = str.substr(start, end - start);
+            auto kv = extract_kv_('=', token);
+            rv[kv.first] = kv.second;
+        }
+
+        start = end + 1;
+    }
+
+    return rv;
