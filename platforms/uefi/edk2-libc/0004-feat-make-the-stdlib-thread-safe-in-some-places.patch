 StdLib/LibC/Uefi/Devices/Console/daConsole.c |  22 ++
 StdLib/LibC/Uefi/SysCalls.c                  |   3 +
 StdLib/StdLib.dsc                            |   1 +
 StdLib/StdLib.inc                            |   1 +
 10 files changed, 576 insertions(+), 4 deletions(-)
